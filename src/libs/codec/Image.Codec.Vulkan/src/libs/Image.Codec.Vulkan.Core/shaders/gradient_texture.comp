#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 1, rgba8) uniform writeonly image2D img;
layout(push_constant) uniform PC { uint width; uint height; uint mode; } pc;

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
  float fx = float(p.x) / float(pc.width - 1);
  float fy = float(p.y) / float(pc.height - 1);
  vec4 c = vec4(fx, fy, 0.5, 1.0);
  if ((p.y / 16) % 2 == 0) c = vec4(1.0 - c.r, c.g, c.b, c.a);
  imageStore(img, p, c);
}
